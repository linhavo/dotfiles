{
  "model": "opus[1m]",
  "permissions": {
    "defaultMode": "auto",
    "allow": ["mcp__pencil"]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "medium" },
    "claude-sonnet-5-5": { "effortLevel": "medium" }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/confirm-push-to-main.sh" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
