# Shared git settings; identity ([user]) stays in the untracked ~/.gitconfig.

[core]
	# Global hooks: a gitleaks scan, then the repo's own .git/hooks/pre-commit.
	hooksPath = ~/.config/git/hooks
[push]
	autoSetupRemote = true
[alias]
	s = switch
	sc = switch -c
	ps = push
	pl = pull
	A = add -A
	cm = commit -m
