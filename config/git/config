# Shared git settings; identity comes from the profile, and the untracked ~/.gitconfig overrides both.

# Loads the profile that install.sh links; git skips it when it is missing.
[include]
	path = ~/.config/dotfiles/profile/gitconfig

[push]
	autoSetupRemote = true
[alias]
	s = switch
	sc = switch -c
	ps = push
	pl = pull
	A = add -A
	cm = commit -m
	chp = cherry-pick
	psfl = push --force-with-lease
