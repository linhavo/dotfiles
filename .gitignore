.DS_Store

# Git LFS writes these into the global hooks path; they stay local to each machine.
config/git/hooks/post-checkout
config/git/hooks/post-commit
config/git/hooks/post-merge
config/git/hooks/pre-push

# World of Codecraft owns these scripts; install.sh links them from its clone.
claude/hooks/wocc-activity.py
claude/hooks/wocc-statusline.py
